{
  "version": 1,
  "rules": [
    {
      "surface": "YOUTUBE_SHORTS",
      "packageName": "com.google.android.youtube",
      "viewIds": [
        "com.google.android.youtube:id/reel_recycler",
        "com.google.android.youtube:id/reel_player_page_container",
        "com.google.android.youtube:id/reel_watch_player"
      ],
      "contentDescriptions": [
        { "text": "Shorts", "requireSelected": true, "exact": true }
      ]
    },
    {
      "surface": "INSTAGRAM_REELS",
      "packageName": "com.instagram.android",
      "viewIds": [
        "com.instagram.android:id/clips_viewer_view_pager",
        "com.instagram.android:id/clips_video_container"
      ],
      "contentDescriptions": [
        { "text": "Reels", "requireSelected": true, "exact": true }
      ]
    },
    {
      "surface": "INSTAGRAM_EXPLORE",
      "packageName": "com.instagram.android",
      "viewIds": [
        "com.instagram.android:id/explore_action_bar_container"
      ],
      "contentDescriptions": [
        { "text": "Search and explore", "requireSelected": true, "exact": true }
      ]
    },
    {
      "surface": "FACEBOOK_WATCH",
      "packageName": "com.facebook.katana",
      "contentDescriptions": [
        { "text": "Video", "requireSelected": true },
        { "text": "Watch", "requireSelected": true }
      ]
    }
  ]
}
